---
import '../styles/global.css';
// Yazı tipleri kendi sunucumuzda. "400.css" gibi dosyalar alt küme başına unicode-range içerir:
// tarayıcı yalnızca sayfada kullanılan alt kümeyi (latin / kiril / arapça) indirir.
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/500.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-mono/500.css';
import latin400 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import latin600 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url';
import cyr400 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-cyrillic-400-normal.woff2?url';
import cyr600 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-cyrillic-600-normal.woff2?url';
import ar400 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';
import ar600 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-600-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_LANG, LANGS, isRtl, type Lang } from '../lib/labels';
import { useUi } from '../i18n/ui';
import { loadCatalog } from '../lib/catalog';
import { withBase } from '../lib/url';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Dil önekinden sonraki yol, örn. "/" ya da "/konfigurator/". Dil değiştirme bağlantıları için. */
  path: string;
  /** Mobilde alt sabit çubuk gösterilsin mi. */
  stickybar?: boolean;
  /** Uygulama modu (konfigüratör): alt bilgi yok, içerik ekranı doldurur. */
  app?: boolean;
  /** Arama motorları dizine eklemesin (404 sayfası). Dil bağlantıları da yazılmaz. */
  noindex?: boolean;
}
const { lang, title, description, path, stickybar = false, app = false, noindex = false } = Astro.props;
const ui = useUi(lang);
// Uygulama modunda (konfigüratör) ürün listesi gerekmez: arama ve sepet yoktur.
const { details } = app ? { details: [] } : await loadCatalog(lang);
const fullTitle = title === ui.site_name ? title : `${title} | ${ui.site_name}`;
// Ekranın üstünde görünen yazı tiplerini dile göre önceden yükle
const preload = lang === 'ar' ? [ar400, ar600] : lang === 'ru' ? [cyr400, cyr600] : [latin400, latin600];
// Paylaşım önizlemesi (Open Graph). Kanonik adres, og:url ve hreflang mutlak adres ister: alan adı belli olunca
// astro.config'e "site" yazılması yeter (o zamana kadar göreli yollar, kanonik ve og:url yazılmaz).
const OG_LOCALE: Record<Lang, string> = { tr: 'tr_TR', en: 'en_US', ru: 'ru_RU', ar: 'ar_AR' };
// geçici önizleme (GitHub Pages): arama motorlarına kapalı
const preview = import.meta.env.PUBLIC_PREVIEW === '1';
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const self = withBase(`/${lang}${path}`);
---

<!doctype html>
<html lang={lang} dir={isRtl(lang) ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {(noindex || preview) && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ui.site_name} />
    <meta property="og:title" content={fullTitle} />
    {Astro.site && !noindex && <link rel="canonical" href={abs(self)} />}
    {Astro.site && !noindex && <meta property="og:url" content={abs(self)} />}
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <link rel="icon" type="image/png" href={withBase('/brand/logo-blue.png')} />
    {preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    {!noindex && LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(withBase(`/${l}${path}`))} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(withBase(`/${DEFAULT_LANG}${path}`))} />}
    <!-- Tema: kayıtlı seçim yoksa sistem tercihi. Titremeyi önlemek için render'dan önce çalışır. -->
    <script is:inline>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('theme');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class={app ? 'app' : undefined}>
    <a class="skip" href="#main">{ui.skip}</a>
    <Header lang={lang} path={path} items={details} shop={!app} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!app && <Footer lang={lang} />}
    {
      stickybar && (
        <div class="stickybar">
          <a class="btn" href={withBase(`/${lang}/konfigurator/`)}>{ui.nav_configurator}</a>
          <a class="btn btn-primary" href="#urunler">{ui.nav_products}</a>
        </div>
      )
    }
    <script>
      // Açık/koyu tema anahtarı
      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
        });
      });

      // Mobil menü
      const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
      const mnav = document.getElementById('mnav');
      menuBtn?.addEventListener('click', () => {
        const open = mnav?.classList.toggle('open') ?? false;
        menuBtn.setAttribute('aria-expanded', String(open));
      });
      mnav?.addEventListener('click', () => {
        mnav.classList.remove('open');
        menuBtn?.setAttribute('aria-expanded', 'false');
      });

      // Dil menüsü: dışarı tıklayınca veya Escape ile kapanır
      const dropdowns = document.querySelectorAll<HTMLDetailsElement>('[data-dropdown]');
      document.addEventListener('click', (e) => {
        dropdowns.forEach((d) => {
          if (d.open && !d.contains(e.target as Node)) d.open = false;
        });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        dropdowns.forEach((d) => {
          if (d.open) {
            d.open = false;
            d.querySelector('summary')?.focus();
          }
        });
      });
    </script>
  </body>
</html>
