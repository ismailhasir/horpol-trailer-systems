---
// Basit çizgi simgeler (24x24). Yeni simge için `paths` içine ekleyin.
interface Props {
  name: 'search' | 'cart' | 'menu' | 'close' | 'sun' | 'moon' | 'check' | 'arrow' | 'minus' | 'plus';
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;
const paths: Record<Props['name'], string[]> = {
  search: ['M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z', 'm20 20-3.8-3.8'],
  cart: ['M3 4h2.4l2.1 10.2a1 1 0 0 0 1 .8h8.7a1 1 0 0 0 1-.76L20 8H6', 'M9.5 19.3h.01', 'M17 19.3h.01'],
  menu: ['M4 7h16', 'M4 12h16', 'M4 17h16'],
  close: ['M6 6l12 12', 'M18 6 6 18'],
  sun: [
    'M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z',
    'M12 2.5v2',
    'M12 19.5v2',
    'm5.3 5.3 1.4 1.4',
    'm17.3 17.3 1.4 1.4',
    'M2.5 12h2',
    'M19.5 12h2',
    'm5.3 18.7 1.4-1.4',
    'm17.3 6.7 1.4-1.4',
  ],
  moon: ['M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7Z'],
  check: ['m4 12.5 5 5L20 6.5'],
  arrow: ['M5 12h14', 'm13 6 6 6-6 6'],
  minus: ['M6 12h12'],
  plus: ['M6 12h12', 'M12 6v12'],
};
---

<svg
  class:list={['icon', cls, name === 'arrow' && 'flip']}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
