---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Steps from '../../components/Steps.astro';
import About from '../../components/About.astro';
import Catalog from '../../components/Catalog';
import { LANGS, type Lang } from '../../lib/labels';
import { useUi } from '../../i18n/ui';
import { loadCatalog } from '../../lib/catalog';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const ui = useUi(lang);
const { cards } = await loadCatalog(lang);
---

<BaseLayout lang={lang} title={ui.site_name} description={ui.hero_lead} path="/" stickybar>
  <Hero lang={lang} />
  <Steps lang={lang} />
  <section class="block catalog">
    <!-- Bağlantı hedefi iç kapta: sayfa, bölümün üst boşluğunu atlayıp başlığa kayar -->
    <div class="wrap" id="urunler">
      <div class="head">
        <p class="eyebrow">{ui.prod_eyebrow}</p>
        <h2>{ui.prod_title}</h2>
        <p>{ui.prod_lead}</p>
      </div>
      <Catalog client:visible items={cards} ui={ui} lang={lang} />
    </div>
  </section>
  <About lang={lang} />
</BaseLayout>
